// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Tier {
  FREE
  STARTER
  PROFESSIONAL
  ELITE
}

model User {
  id                   String         @id // Map to Supabase auth.uid()
  email                String?        @unique
  tier                 Tier           @default(FREE)
  dailyLimit           Int            @default(10)
  maxCampaigns         Int            @default(1)
  leadsFoundToday      Int            @default(0)
  creditBalance        Int            @default(0)
  lastQuotaReset       DateTime       @default(now())
  monthlyCycleLimit    Int            @default(0)
  cyclesRemaining      Int            @default(0)
  leadsPerCycle        Int            @default(10)
  automationMode       CycleAutomationMode @default(MANUAL)
  autoRunFrequency     AutoRunFrequency @default(MANUAL)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  paymentStatus        String         @default("free") // active, free, past_due, canceled, incomplete
  profile              Profile?
  campaigns            Campaign[]
  transactions         Transaction[]
  cycleRuns            CycleRun[]
  createdAt            DateTime       @default(now())
}

enum AutoRunFrequency {
  MANUAL
  WEEKLY
  EVERY_2_DAYS
  DAILY
}

enum CycleAutomationMode {
  MANUAL
  AUTOMATIC
  SMART
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  companyName        String?
  industry           String?
  website            String?
  defaultSenderName  String?
  defaultSenderRole  String?
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Campaign {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  status             CampaignStatus @default(ACTIVE)
  
  // Identity (Per-Campaign)
  senderName         String
  senderRole         String
  companyName        String
  
  // Search Context
  targetCountry      String         @default("ZW")
  locations          String[]
  industries         String[]
  
  // Product & Outreach IQ
  productName        String
  productDescription String         @db.Text
  targetPainPoints   String         @db.Text
  outreachTone       OutreachTone   @default(PROFESSIONAL)
  ctaLink            String?
  
  targetMarket       String?        @db.Text
  targetBusinessSize BusinessSize   @default(ANY)
  assignedSources    String[]       @default(["GOOGLE_MAPS"])
  
  discordWebhook     String?
  leads              Lead[]
  cycleRuns          CycleRun[]
  queryHistory       QueryHistory[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

enum BusinessSize {
  SMALL
  MEDIUM
  LARGE
  ANY
}

enum OutreachTone {
  PROFESSIONAL
  DIRECT
  FRIENDLY
  EDUCATIONAL
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  EXHAUSTED
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  address            String?
  category           String?
  website            String?
  phone              String?
  email              String?
  description        String?
  contactStatus      String?
  companySize        String?
  contactPages       Json?
  socialProfiles     Json?
  decisionMakers     Json?
  bestContactChannel String?
  contactConfidence  Int?
  contactEvidence    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  leads              Lead[]

  @@index([name])
  @@index([phone])
  @@index([website])
  @@index([contactStatus])
}

enum LeadStatus {
  NEW
  CONTACT_ROUTE_OPENED
  CONTACTED
  CONVERTED
  REJECTED
}

model Lead {
  id               String      @id @default(cuid())
  campaignId       String
  campaign         Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cycleRunId       String?
  cycleRun         CycleRun?   @relation(fields: [cycleRunId], references: [id], onDelete: SetNull)
  businessId       String
  business         Business    @relation(fields: [businessId], references: [id])
  industry         String
  painPoint        String
  suggestedMessage String
  status           LeadStatus  @default(NEW)
  dispatchedAt     DateTime?
  sweepDate        DateTime?   // For cycle timestamp
  sweepId          String?
  createdAt        DateTime    @default(now())

  @@unique([campaignId, businessId])
  @@index([campaignId])
  @@index([cycleRunId])
}

enum CycleRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum CycleTriggerType {
  AUTO
  MANUAL
  SYSTEM
}

model CycleRun {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status         CycleRunStatus   @default(QUEUED)
  triggerType    CycleTriggerType @default(MANUAL)
  maxLeads       Int
  leadsFound     Int              @default(0)
  maxRuntimeMs   Int              @default(900000)
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  costEstimate   Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  leads          Lead[]

  @@index([userId, status])
  @@index([campaignId, createdAt])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String            @default("USD")
  status      TransactionStatus @default(PENDING)
  gateway     PaymentGateway
  type        TransactionType
  tier        Tier?             // Added to store what the user is buying
  gatewayRef  String?           @unique // Stripe Session ID or Paynow Poll URL
  createdAt   DateTime          @default(now())
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentGateway {
  STRIPE
  PAYNOW
}

enum TransactionType {
  SUBSCRIPTION
  CREDIT_TOPUP
  CYCLE_PACK
}

model QueryHistory {
  id         String    @id @default(cuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location   String
  industry   String
  query      String
  page       Int       @default(1)
  createdAt  DateTime  @default(now())

  @@unique([location, industry, campaignId])
}
