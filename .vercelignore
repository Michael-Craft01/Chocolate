# ── Vercel Deploy Ignore ──────────────────────────────────────────────────────
# Vercel only needs the frontend directory and shared prisma schema.
# Exclude everything else to speed up deploys and protect secrets.

# Backend engine (not deployed to Vercel)
src/
dist/
scripts/
scratch/
debug/
views/

# Local dev files
*.log
output.log
error.log
startup_error*.log
test-output.txt
google_diag.png
scraper_debug.png

# One-off utility scripts at root
check_user.ts
clear*.ts
clear*.js
capture-search.ts
diagnostic*.ts
query_users.ts
refill_user_cycles.ts
upgrade_user.ts
test-lead-quality.ts
test-messaging.ts
test.cjs
test.js

# Local env (never deploy)
.env
.env.local
frontend/.env.local

# Docker / Fly.io / Railway (not Vercel)
Dockerfile
.dockerignore
docker-compose.yml
fly.toml
railway.toml

# Docs / agent config
architecture.md
tech-stack.md
.junie/
.vscode/
.agents/

# Node modules — Vercel installs fresh
node_modules/
frontend/node_modules/
